<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>NodeResearchBranches</RootNamespace>
    <AssemblyName>NodeResearchBranches</AssemblyName>
    <Nullable>enable</Nullable>
    <UnityModules>CoreModule;IMGUIModule;TextRenderingModule</UnityModules>
    <!-- Node Research is built against net48; the game loads both, so accept the reference from net472. -->
    <ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>true</ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>
    <NodeResearchDll Condition="'$(NodeResearchDll)' == ''">C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\3729878405\1.6\Assemblies\BetterResearchMenu.dll</NodeResearchDll>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BetterResearchMenu">
      <HintPath>$(NodeResearchDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="VerifyNodeResearchReference" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(NodeResearchDll)')"
           Text="Node Research's BetterResearchMenu.dll not found at '$(NodeResearchDll)'. Subscribe to Node Research or pass -p:NodeResearchDll=..." />
  </Target>
</Project>
